# Discord Bot Configuration
# Copy this file to .env and replace with your actual tokens and keys
# =====================================================================

# Discord Bot Token (required)
# Get this from the Discord Developer Portal: https://discord.com/developers/applications
DISCORD_BOT_TOKEN=YOUR_DISCORD_BOT_TOKEN

# Wafer API Key (required for default text LLM)
# Get this from Wafer: https://www.wafer.ai/
WAFER_API_KEY=YOUR_WAFER_API_KEY

# Wafer LLM Configuration (optional)
# Default model is "deepseek-v4-flash" on Wafer
WAFER_MODEL=deepseek-v4-flash
WAFER_BASE_URL=https://pass.wafer.ai/v1

# Image Analysis Configuration (optional)
# Image attachments are analyzed with a vision model over the OpenRouter key above.
# Set to false to disable analyzing image attachments.
ENABLE_IMAGE_ANALYSIS=true
# Vision model used for image analysis (must support image input)
VISION_MODEL=deepseek/deepseek-v4-flash-vision-exp

# Rate Limiting Configuration (optional)
# Time between allowed requests per user (in seconds)
RATE_LIMIT_SECONDS=10
# Maximum requests per user per minute
MAX_REQUESTS_PER_MINUTE=6

# Firecrawl API Key (required for link scraping)
# Get this from Firecrawl: https://firecrawl.dev
FIRECRAWL_API_KEY=YOUR_FIRECRAWL_API_KEY

# Firecrawl Timeout Configuration (optional)
# Maximum duration in milliseconds before aborting a scrape request
# Default: 900000ms (15 minutes) - maximum practical value
FIRECRAWL_TIMEOUT_MS=900000

# Apify API Token (optional, for x.com/twitter.com link scraping)
# Get this from Apify: https://apify.com
# If not provided, Twitter/X.com links will be processed using Firecrawl
APIFY_API_TOKEN=YOUR_APIFY_API_TOKEN

# Daily Summary Configuration (optional)
# Hour of the day to run summarization (UTC, 0-23)
SUMMARY_HOUR=0
# Minute of the hour to run summarization (0-59)
SUMMARY_MINUTE=0
# Channel ID to post daily channel summaries (optional)
REPORTS_CHANNEL_ID=YOUR_CHANNEL_ID
# Channel ID where point awards will be appended to the daily summary (optional)
# If not set, will auto-detect a channel named "general" or use the first active channel
GENERAL_CHANNEL_ID=YOUR_GENERAL_CHANNEL_ID
# Optional: restrict daily summaries to specific channel IDs (comma-separated)
SUMMARY_CHANNEL_IDS=CHANNEL_ID_1,CHANNEL_ID_2

# Links Dump Channel Configuration (optional)
# Channel where only links are allowed - text messages will be auto-deleted
LINKS_DUMP_CHANNEL_ID=

# X/Twitter Link Rewriting (optional)
# The bot serves x.com/twitter.com links through an embed-friendly mirror so Discord
# renders them properly. The author's stored message row - and therefore their point
# credit - stays keyed to them in every mode.
# repost = repost the author's full message under the bot with the links fixed
#          ("<name> posted: ..."), then delete the original (default, needs Manage Messages)
# thread = post the fixed link in a thread on the original message
# reply  = post the fixed link as an in-channel reply
# off    = disable
X_LINK_REWRITE_MODE=repost
# Mirror domain (e.g. fixupx.com, fxtwitter.com, vxtwitter.com)
X_LINK_REWRITE_DOMAIN=fixupx.com
# Language the mirror renders tweets in, appended as the last path segment
# (https://fixupx.com/user/status/123/en). Leave empty to keep the original language.
X_LINK_REWRITE_LANGUAGE=en
# Maximum links rewritten per message
X_LINK_REWRITE_MAX_LINKS=5
# Seconds to wait before creating the thread - creating it too soon glitches the
# thread because Discord is still processing the message. 0 disables the delay.
X_LINK_REWRITE_THREAD_DELAY_SECONDS=2
# Hide the original (broken) X embed after posting the fixed one (thread/reply mode
# only - a repost deletes the original outright). Needs Manage Messages.
X_LINK_SUPPRESS_ORIGINAL_EMBED=false
# Most attachments a repost will re-upload. Messages with more are left alone.
X_LINK_REPOST_MAX_ATTACHMENTS=10


# Fred Access (optional)
# /fred sells timed access to Fred (the Hermes agent, nick of frenbot), gated by a
# Discord role that an admin must create. The bot never creates the role itself.
# Points charged per redemption
FRENBOT_ACCESS_COST=10
# Hours granted per redemption (redeeming while active stacks and charges again)
FRENBOT_ACCESS_DURATION_HOURS=1
# Name of the role that gates access - must exist, and must sit below the bot's
# highest role for the bot to be able to assign it
FRENBOT_ACCESS_ROLE_NAME=fred-access
# Most hours of access a user may hold at once. 0 disables the cap.
FRENBOT_ACCESS_MAX_HOURS=24

# HTTP Headers for API requests (optional)
# These are used in LLM API requests for tracking/identification
# Default: https://techfren.net
HTTP_REFERER=https://techfren.net
# Default: TechFren Discord Bot
X_TITLE=TechFren Discord Bot

# techfriendcommunity bridge (optional)
# Mirrors public channels to the techfriendcommunity.com web app and creates one
# webhook per channel (needs Manage Webhooks) so web/email posts can appear in Discord.
BRIDGE_ENABLED=false
CONVEX_INGEST_URL=https://YOUR_DEPLOYMENT.convex.site
BRIDGE_SECRET=CHANGE_ME_LONG_RANDOM
# BRIDGE_GUILD_ID=123456789012345678
# BRIDGE_EXCLUDE_CHANNEL_IDS=111,222

# Honeypot trap (optional, off by default)
# Catches spam accounts that post in a designated trap channel. An account is only
# ever actioned if it holds none of the trusted roles, has no points history, and
# is not established (see below), so active members cannot be caught by it.
# Register a trap channel with /honeypot-set (admin only) once enabled.
HONEYPOT_ENABLED=false
# true = score and log every hit but punish nobody. Leave this on for a week, read
# /honeypot-hits, then decide.
HONEYPOT_DRY_RUN=true
# Where decisions are reported (usually the mod-log channel). Optional: hits are
# written to the honeypot_hits table either way.
# HONEYPOT_LOG_CHANNEL_ID=1463709753095094292
# Comma-separated role IDs whose holders are immune. Explicit allow-list on
# purpose: the self-assignable /color roles outrank the join role, so "any role
# above fren" would let a spam account immunise itself by picking a colour. The
# values below are this server's non-join roles; the join role (fren,
# 1053872292381327492) is deliberately absent, and the trap refuses to act at all
# while this is empty.
HONEYPOT_TRUSTED_ROLE_IDS=1303354826251436045,1306413611580653599,1235430975870210149,1303355924903104563,1053872559235547246,1053868785045614743,1053880905229406248
# Seconds a single-trigger hit is timed out for.
HONEYPOT_TIMEOUT_MINUTES=60

# Everything else is policy rather than configuration and lives as constants in
# honeypot_handler.py, so the trap's behaviour can be read in one file:
#   triggers   - invite/link in the trap channel, account under 24h old, posting in
#                3+ channels within 60s, identical text in 2+ channels
#   response   - one trigger = delete + timeout; two triggers, or any trigger on
#                an account already caught before = ban
#   immunity   - trusted role or any points history: no action at all
#   ban shield - an account 30+ days old that joined 14+ days ago is still deleted
#                and timed out, but can never be banned

# Privileged members intent. The honeypot works without it (join dates come from
# message payloads); enabling it also records joins for members who never post,
# and requires the toggle in the Discord Developer Portal.
ENABLE_MEMBERS_INTENT=false
